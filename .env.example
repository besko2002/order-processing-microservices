# Copy to .env and adjust. Every variable below has a working default baked into
# docker-compose.yml / the services' application.yml, so an empty .env also works.
#
# The defaults are DEVELOPMENT defaults and are named like it (see the checklist at the end of
# this file). Two integrations are simulated and stay simulated: payments (no acquirer, no money)
# and e-mail (a local MailHog sink, no real inbox).
#
# Which variables reach the containers: the infrastructure, credential, JWT, admin, gateway,
# payment, notification and saga settings below are passed into the containers by
# docker-compose.yml, so they apply in BOTH workflows (services on the host, or --profile app).
# The per-service tuning knobs further down (outbox relay, circuit breaker, retries, logging,
# tracing sampling) are read by a service you start on the host; the containers use the defaults
# in that service's application.yml.

# ---------------------------------------------------------------- infrastructure
# The interface every published port is bound to. 127.0.0.1 (default) keeps the development
# stack unreachable from the network. Set it to 0.0.0.0 only for a deliberate deployment, and
# then work through the checklist at the end of this file first.
BIND_ADDRESS=127.0.0.1

# LOCAL-DEVELOPMENT CREDENTIALS. The values below are development placeholders and are named
# like it on purpose - they must never be reused anywhere else. Replace every one of them
# before the stack runs on a network (checklist at the end of this file).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

KAFKA_EXTERNAL_PORT=9094
# The address clients dial to reach the broker. "localhost" while the broker runs on this
# machine; the host's real address when it runs somewhere else (it is advertised to clients).
KAFKA_EXTERNAL_HOST=localhost
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

REDIS_PORT=6380
# Empty means Redis has no authentication - fine for a local cache bound to 127.0.0.1. Set a
# value before it goes on a network: the server then requires it and the gateway sends it.
REDIS_PASSWORD=

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------------------------------------------------------------- per-service databases
# These are the credentials the services connect with AND the ones the database bootstrap
# creates (infra/postgres/init/01-create-databases.sh reads them). Change them here only in a
# fresh environment: the bootstrap runs once, on an empty volume.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_local_dev_only

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_local_dev_only

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_local_dev_only

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_local_dev_only

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_local_dev_only

DB_POOL_MAX_SIZE=5

# ---------------------------------------------------------------- kafka consumers
# Set per service when running several from one shell; each has its own default.
# KAFKA_CONSUMER_GROUP=order-service
KAFKA_AUTO_OFFSET_RESET=earliest

# ---------------------------------------------------------------- service ports
# SERVER_PORT is read by whichever service is being started (defaults: 8080..8085).
# SERVER_PORT=8082

# ---------------------------------------------------------------- gateway routes
AUTH_SERVICE_URI=http://localhost:8081
ORDER_SERVICE_URI=http://localhost:8082
INVENTORY_SERVICE_URI=http://localhost:8083
PAYMENT_SERVICE_URI=http://localhost:8084
NOTIFICATION_SERVICE_URI=http://localhost:8085

# ---------------------------------------------------------------- api-gateway (phase 3)
# Where the gateway fetches auth-service's public keys, and the issuer it insists on.
# Keys are loaded lazily and cached, so the gateway may start before auth-service.
# The same two variables are read by every servlet service through service-support: each one
# validates the bearer token again for itself, so reaching a service port directly is not a
# way around the gateway.
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
# AUTH_JWT_ISSUER is shared with auth-service above - both must agree.

# Browser origins allowed to call the gateway (comma separated, exact scheme+host+port).
GATEWAY_CORS_ORIGINS=http://localhost:5173

# Redis-backed token bucket, one bucket per route and per caller (user id when the request
# carries a valid token, otherwise the client IP). If Redis is unreachable the gateway logs a
# WARN and lets the request through - rate limiting protects against abuse, it is not an
# authorisation decision, and a cache outage must not become an API outage.
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_REQUESTED_TOKENS=1

# Rate-limit Redis (the same container as REDIS_PORT above). Timeouts are short on purpose:
# they bound how long a request can wait before the limiter gives up and fails open.
REDIS_HOST=localhost
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms

# ---------------------------------------------------------------- auth-service (phase 2)
# RS256 signing key pair. Leave all three EMPTY for local development: auth-service then
# generates a 2048-bit RSA pair at startup and logs a WARN (tokens do not survive a
# restart). NEVER commit a real private key - keep it in .env (git-ignored) or a secret
# manager. Generate a pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Both values accept a real multi-line PEM or a single line with literal \n escapes.
# AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
# AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----
# Key id published in the JWKS and in the token header (defaults to a random UUID).
# AUTH_JWT_KEY_ID=auth-2025-01
AUTH_JWT_ISSUER=order-processing-auth
AUTH_JWT_EXPIRATION=PT1H

# Idempotent admin seeding on startup.
AUTH_ADMIN_EMAIL=admin@orders.local
AUTH_ADMIN_PASSWORD=Admin@LocalDevOnly
AUTH_ADMIN_NAME=Platform Admin

# ---------------------------------------------------------------- inventory-service (phase 4)
# Insert a handful of demo products at startup so a fresh local catalog is not empty. Idempotent
# (products are matched by SKU) and never resets stock; default is false everywhere else.
INVENTORY_SEED_DEMO=true
# Attempts per reserve/release/commit before an optimistic-locking conflict gives up with a 409.
INVENTORY_RESERVATION_MAX_ATTEMPTS=3
# Where inventory-service asks order-service for an order's state before the operator reconciliation
# (POST /api/inventory/reservations/reconcile) releases anything: GET /api/orders/{id}, with the
# calling administrator's own bearer token (no service credential), and only CANCELLED / REJECTED
# orders are acted on. docker compose sets http://order-service:8082. Short timeouts on purpose; after
# 3 consecutive failures a batch stops asking and reports the rest as skipped.
ORDER_BASE_URL=http://localhost:8082
ORDER_CONNECT_TIMEOUT_MS=1000
ORDER_READ_TIMEOUT_MS=2000

# ---------------------------------------------------------------- order-service (phase 5)
# Where order-service reads product prices when an order is placed. The snapshot is taken
# server-side, so a client never sends a price.
INVENTORY_BASE_URL=http://localhost:8083
# Short on purpose: this call sits inside POST /api/orders, so the customer's worst case is
# bounded by us and not by inventory-service's health.
INVENTORY_CONNECT_TIMEOUT_MS=1000
INVENTORY_READ_TIMEOUT_MS=2000
# Retry + circuit breaker around that call. Only a timeout, a dropped connection or a 5xx counts
# as a failure; an unknown product is a 400 the caller caused, and is neither retried nor recorded.
INVENTORY_RETRY_MAX_ATTEMPTS=3
INVENTORY_RETRY_WAIT=200ms
INVENTORY_CB_WINDOW=20
INVENTORY_CB_MINIMUM_CALLS=10
INVENTORY_CB_FAILURE_RATE=50
INVENTORY_CB_OPEN_WAIT=10s
INVENTORY_CB_HALF_OPEN_CALLS=3

# Transactional outbox relay. Events are written to outbox_events in the same transaction as the
# order, then published from there by a scheduled poll that claims rows with
# FOR UPDATE SKIP LOCKED (so several order-service instances can relay at once).
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_SEND_TIMEOUT=PT15S
# How long published rows are kept as the audit trail of what this service announced.
OUTBOX_RETENTION=P7D
OUTBOX_CLEANUP_MS=3600000
# Set to false to keep the relay bean but stop its timer (tests drive it by hand).
OUTBOX_SCHEDULER_ENABLED=true

# Saga-timeout sweeper: an order that has not reached a final state within this duration is
# cancelled with compensation (stock released, payment refunded, customer notified).
ORDER_SAGA_TIMEOUT=PT2M

# Refund-recovery sweep: a RefundPayment that payment-service never answered is re-commanded after
# this interval, measured from the last attempt. Runs on the same sweeper tick as the order
# timeout; payment-service refunds exactly once per order, so a harmless duplicate command is
# bounded and safe.
ORDER_SAGA_REFUND_RETRY_INTERVAL=PT30S

# ---------------------------------------------------------------- payment-service
# The payment provider here is SIMULATED: charges and refunds only flip rows in payment-service's
# payments table. No real money moves, no real acquirer is called, and no real card details exist
# anywhere in this project (see README "What is simulated").
# Provider references it hands out start with "SIM-" and are not acquirer references, and every
# payment the API returns carries "simulated": true.
PAYMENT_DECLINE_ABOVE=1000.00
PAYMENT_FAILURE_RATE=0
# Attempts per payment command before an optimistic-locking conflict gives up.
PAYMENT_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- notification-service
# SMTP sender address. Mail goes out through MailHog's SMTP sink - a local development sink, NOT a
# delivery service: nothing reaches a real inbox. Every notification the API returns carries
# "simulated": true, and its status says whether the sink accepted the message, not that anybody
# received it.
# notification-service is also honest about delivery: SMTP is at-least-once under redelivery, not
# guaranteed-once, and a mail that cannot be sent is dropped with a WARN after retries.
NOTIFICATION_FROM=orders@orders.local
# Recipients are synthetic on purpose: every mail is addressed to
# <customerId>@NOTIFICATION_RECIPIENT_DOMAIN, which MailHog accepts without ever being a
# real person's inbox. Never point this at a real mail domain.
NOTIFICATION_RECIPIENT_DOMAIN=customers.orders.local

# ---------------------------------------------------------------- actuator / logging
MANAGEMENT_ENDPOINTS=health,info
MANAGEMENT_HEALTH_SHOW_DETAILS=always
# api-gateway only: set to "none" to hide /actuator/gateway/routes.
MANAGEMENT_GATEWAY_ENDPOINT_ACCESS=unrestricted
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_GATEWAY=INFO

# ---------------------------------------------------------------- observability
# Traces are exported over OTLP/HTTP to Jaeger (docker compose --profile observability).
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
# Switches only the span EXPORT; tracing (trace ids in the logs, traceparent over Kafka) is always on.
# Left unset: true for services on the host, false for the containers of `--profile app`, because
# Jaeger is not part of that profile and an exporter with no collector logs an ERROR per batch.
# docker-compose.yml reads this same variable, so uncommenting it as true makes the containers
# export too - only do that together with `--profile observability`:
#   docker compose --profile app --profile observability up -d
# Set it to false when running services on the host without Jaeger.
# OTLP_TRACING_EXPORT_ENABLED=true
# Share of requests traced (1.0 = all; lower it under real load).
TRACING_SAMPLING_PROBABILITY=1.0
# Grafana admin password (anonymous users get read-only access).
GRAFANA_ADMIN_PASSWORD=grafana_local_dev_only

# ---------------------------------------------------------------- before deploying on a network
# The defaults in this file are DEVELOPMENT placeholders. Before this stack is reachable from
# anywhere but this machine:
#
#   1. BIND_ADDRESS=0.0.0.0 deliberately (it is 127.0.0.1 by default, so nothing is published
#      to the network until you change it).
#   2. Replace every *_PASSWORD / *_SUPERUSER_PASSWORD value above (Postgres superuser, the five
#      per-service database users, REDIS_PASSWORD, GRAFANA_ADMIN_PASSWORD, AUTH_ADMIN_PASSWORD)
#      with its own strong value. The database bootstrap only runs on an empty volume, so change
#      them before the first start.
#   3. Set AUTH_JWT_PRIVATE_KEY and AUTH_JWT_PUBLIC_KEY to a real key pair (see above). Without
#      them auth-service generates a throw-away pair at every start and every token dies with it.
#   4. Set KAFKA_EXTERNAL_HOST to the address clients should dial, and OTLP_TRACING_EXPORT_ENABLED
#      to true only together with the observability profile.
#   5. Postgres, Kafka, Redis and MailHog have no authentication of their own beyond what is
#      listed here - keep them on a private network or behind a firewall.
